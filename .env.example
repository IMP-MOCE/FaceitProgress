# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.

APP_ENV=development

# Строка подключения SQLAlchemy (драйвер psycopg 3)
DATABASE_URL=postgresql+psycopg://faceit:faceit@localhost:15432/faceit

# Секрет подписи JWT: не короче 32 символов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_MINUTES=30

# Разрешённые origin для CORS (JSON-список)
CORS_ORIGINS=["http://localhost:5173"]

# Ключ FACEIT Data API. Пусто — сервис работает на встроенных демо-данных.
FACEIT_API_KEY=

# Попыток входа в минуту на пару IP + email
LOGIN_RATE_LIMIT=5

# Swagger UI на /docs (в production лучше выключить)
DOCS_ENABLED=true
